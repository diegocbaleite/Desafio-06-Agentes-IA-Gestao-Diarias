# Copie para .env e preencha. O .env está no .gitignore e nunca deve ser versionado.
OPENAI_API_KEY=
# Modelo de referência do desafio. Troque apenas se a API recusar, e registre a troca no relatório.
# Também é aceito MODELO_LLM=openai/gpt-5.6-luna (o prefixo do provedor é descartado).
MODELO_DIARIAS=gpt-5.6-luna
# Limites (justificativa no LEIA-ME.md)
TOOL_CALL_LIMIT=6
NUM_HISTORY_RUNS=3
PARALLEL_TOOL_CALLS=false
# Preços em US$ por milhão de tokens (Aula 06, Seção 4.2)
USD_ENTRADA_POR_MILHAO=0.20
USD_SAIDA_POR_MILHAO=1.20
AGNO_TELEMETRY=false
